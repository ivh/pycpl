prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: hdrl
Description: HDRL (High Level Datareduction Library)
Version: @PACKAGE_VERSION@
URL: https://www.eso.org/sci/software/cpl
Requires.private: gsl, erfa, libcurl
Libs: -L${libdir} -lhdrl -lcpldrs -lcpldfs -lcplui -lcplcore -lcext
Libs.private: @LIBS@ -pthread
Cflags: -I${includedir} -I${includedir}/hdrl
