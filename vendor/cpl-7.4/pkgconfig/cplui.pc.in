prefix=@prefix@
exec_prefix=@exec_prefix@
includedir=@includedir@
libdir=@libdir@

Name: cplui
Description: CPL library (cplui component library)
URL: https://www.eso.org/sci/software/cpl 
Version: @VERSION@
Requires: cplcore = @VERSION@
Libs: -L${libdir} -lcplui
Libs.private: @LIBS@ -lm -pthread
Cflags: -I${includedir}
